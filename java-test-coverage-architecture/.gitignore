# Python bytecode cache — regenerable, no debe versionarse
__pycache__/
*.pyc
*.pyo
*.pyd

# Estado generado por el pipeline (artefactos de ejecución, no código fuente).
# Todos los state/*.json los crea run_pipeline.py o sus sub-scripts; preservamos
# state/_schemas/, state/index/README.md y state/.gitkeep.
state/*.json
state/_patches/
state/context-packs/
state/symbol-contracts/

# Entornos virtuales locales
.venv/
venv/
env/
