{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/ast-patch.schema.json",
  "title": "AST Patch",
  "description": "Surgical AST modifications emitted by the Surgical Generator and Deterministic Repair Engine. Applied by tools/python/ast_patcher.py.",
  "type": "object",
  "required": ["patchId", "targetFile", "sutFqcn", "ops", "evidenceIds"],
  "additionalProperties": false,
  "properties": {
    "patchId":     { "type": "string", "pattern": "^p-[a-f0-9]{8,}$" },
    "targetFile":  { "type": "string", "description": "Workspace-relative path under src/test/java." },
    "sutFqcn":     { "type": "string", "description": "Fully-qualified name of the SUT this patch targets." },
    "createsFile": { "type": "boolean", "default": false, "description": "True only when the test class does not yet exist. Otherwise patches edit-in-place." },
    "templateRef": { "type": "string", "description": "Optional reference to templates/<name>.java when createsFile=true." },
    "evidenceIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "tokenCost":   { "type": "integer", "minimum": 0, "description": "Reported by the generator for state/token-metrics.json." },
    "ops": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Op" }
    }
  },
  "$defs": {
    "Anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind":    { "enum": ["endOfClass", "beforeMethod", "afterMethod", "atLine", "endOfImports", "endOfFields"] },
        "method":  { "type": "string", "description": "Method name when kind is beforeMethod/afterMethod." },
        "line":    { "type": "integer", "minimum": 1 }
      }
    },
    "Op": {
      "oneOf": [
        {
          "type": "object",
          "required": ["op", "anchor", "source"],
          "additionalProperties": false,
          "properties": {
            "op":     { "const": "InsertMethod" },
            "anchor": { "$ref": "#/$defs/Anchor" },
            "source": { "type": "string", "description": "Method source. MUST NOT include surrounding class braces." }
          }
        },
        {
          "type": "object",
          "required": ["op", "target", "replacement"],
          "additionalProperties": false,
          "properties": {
            "op":          { "const": "ReplaceAssertion" },
            "target":      { "type": "string", "description": "Existing assertion expression to replace (verbatim or unique substring)." },
            "replacement": { "type": "string" },
            "inMethod":    { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["op", "target", "replacement"],
          "additionalProperties": false,
          "properties": {
            "op":          { "const": "ReplaceStatement" },
            "target":      { "type": "string" },
            "replacement": { "type": "string" },
            "inMethod":    { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["op", "fqn"],
          "additionalProperties": false,
          "properties": {
            "op":     { "const": "AddImport" },
            "fqn":    { "type": "string" },
            "static": { "type": "boolean", "default": false }
          }
        },
        {
          "type": "object",
          "required": ["op", "type", "name"],
          "additionalProperties": false,
          "properties": {
            "op":         { "const": "AddMock" },
            "type":       { "type": "string", "description": "Fully-qualified type of the mock collaborator." },
            "name":       { "type": "string" },
            "annotation": { "enum": ["@Mock", "@MockBean", "@Spy"], "default": "@Mock" }
          }
        },
        {
          "type": "object",
          "required": ["op", "target", "annotation"],
          "additionalProperties": false,
          "properties": {
            "op":         { "const": "InsertAnnotation" },
            "target":     { "type": "string", "description": "Class name or 'class:<Name>' or 'method:<Name>'." },
            "annotation": { "type": "string", "description": "Annotation source incl. @ and arguments." }
          }
        }
      ]
    }
  }
}
