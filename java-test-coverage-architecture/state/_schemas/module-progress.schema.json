{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "module-progress.schema.json",
  "description": "Progreso por módulo Maven/Gradle dentro del ciclo activo. Estado auxiliar opcional escrito por el orchestrator cuando el repo es multimódulo. Cada clave de 'modules' es el nombre del módulo (matches state/build-tool-contract.json#/modules/*/name).",
  "type": "object",
  "additionalProperties": false,
  "required": ["modules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "modules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "phase": {
            "type": "string",
            "enum": [
              "discovery", "stack-profile", "classification", "symbol-contract",
              "dependency-graph", "fixtures", "planning", "generation",
              "validation", "repair", "reporting", "done"
            ]
          },
          "cycle":      { "type": "integer", "minimum": 0 },
          "lastUpdate": { "type": "string", "format": "date-time" },
          "status":     { "type": "string", "enum": ["PENDING", "IN_PROGRESS", "BLOCKED", "COMPLETED"] },
          "blockReason": { "type": ["string", "null"] },
          "coverage": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "lines":    { "type": "number", "minimum": 0, "maximum": 1 },
              "branches": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    }
  }
}
